---
import Base from '../layouts/Base.astro';
import { getSongs, getPhases, getEvents, getWorks, hasBackground, url, formatDate } from '../lib/data';
const songs = await getSongs();
const phases = await getPhases();
const recent = songs
  .filter(hasBackground)
  .sort((a, b) => (b.data.reviewedAt ?? '').localeCompare(a.data.reviewedAt ?? ''))
  .slice(0, 6);
const withBg = songs.filter(hasBackground).length;
const events = await getEvents();
const works = (await getWorks()).filter((w) => w.type !== '配信');
const lives = events.filter((e) => e.data.kind === 'live').length;
---
<Base>
  <section class="hero">
    <p class="eyebrow">UNOFFICIAL FAN ARCHIVE</p>
    <h1 class="hero-title"><span class="en">Mrs. GREEN APPLE</span><span class="ja">の歴史と曲の背景</span></h1>
    <div class="marquee" aria-hidden="true"><div>{Array(2).fill(phases.map((p) => p.data.name).join(' ✦ ') + ' ✦ ').join('')}</div></div>
  </section>
  <p class="lead">結成から現在までの流れと、1曲ずつの背景をまとめた非公式サイトです。本人たちの発言や公式発表には出典を付け、考察とは分けて書いています。</p>
  <form class="search" action={url('/songs/')} method="get" role="search">
    <input name="q" type="search" placeholder="曲名・タイアップ作品名で探す" aria-label="曲を検索" />
    <button type="submit">検索</button>
  </form>
  <div class="entries">
    <a class="card entry" href={url('/timeline/')}>
      <span class="num">01</span><strong>年表から読む</strong>
      <span class="muted">{phases.map((p) => p.data.name).join(' → ')}</span>
    </a>
    <a class="card entry" href={url('/songs/')}>
      <span class="num">02</span><strong>曲から読む</strong>
      <span class="muted">全{songs.length}曲（解説あり {withBg}曲）</span>
    </a>
    <a class="card entry" href={url('/works/')}>
      <span class="num">03</span><strong>作品から読む</strong>
      <span class="muted">アルバム・シングル {works.length}作品</span>
    </a>
    <a class="card entry" href={url('/members/')}>
      <span class="num">04</span><strong>メンバーを知る</strong>
      <span class="muted">メンバーのプロフィールと歩み</span>
    </a>
  </div>
  <p class="stats muted">年表の出来事 {events.length}件（うちライブ {lives}件）</p>
  <div class="random">
    <button type="button" id="random" data-urls={JSON.stringify(songs.filter(hasBackground).map((s) => url(`/songs/${s.id}/`)))}>ランダムに1曲読む</button>
  </div>
  {recent.length > 0 && (
    <>
      <h2>最近追加された解説</h2>
      <ul>
        {recent.map((s) => (
          <li><a href={url(`/songs/${s.id}/`)}>{s.data.title}</a> <span class="muted">{formatDate(s.data.releaseDate)}</span></li>
        ))}
      </ul>
    </>
  )}
</Base>
<script>
  const btn = document.getElementById('random')!;
  const urls: string[] = JSON.parse(btn.dataset.urls!);
  btn.addEventListener('click', () => { location.href = urls[Math.floor(Math.random() * urls.length)]; });
</script>
<style>
  .search { display: flex; gap: .5rem; margin: 1.5rem 0 .5rem; }
  .search input { flex: 1; padding: .7rem 1rem; border-radius: 999px; font-size: 1rem; }
  button { font: inherit; font-weight: 700; cursor: pointer; color: var(--bg); background: var(--accent); border: 0; border-radius: 999px; padding: .6rem 1.3rem; transition: transform .3s var(--ease), box-shadow .3s; }
  button:hover { transform: translateY(-2px); box-shadow: 0 10px 30px -10px var(--accent); }
  .random { margin: 1rem 0 2rem; }
  .stats { margin: 0; }
  .hero { padding: 3rem 0 1rem; }
  .eyebrow { font-family: var(--en); font-weight: 800; font-size: .75rem; letter-spacing: .3em; color: var(--accent); margin: 0; }
  .hero-title { display: flex; flex-direction: column; margin: .5rem 0 1.5rem; }
  .hero-title .en { font-family: var(--en); font-weight: 800; font-size: clamp(2.6rem, 10vw, 5.5rem); line-height: 1.02; letter-spacing: -.02em;
    background: linear-gradient(100deg, #FAFFDF 20%, #E2FF91 45%, #A7DA20 55%, #FAFFDF 80%); background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: shine 7s linear infinite, rise 1.2s var(--ease) both; }
  .hero-title .ja { font-size: clamp(1.1rem, 3vw, 1.5rem); margin-top: .5rem; animation: rise 1.2s var(--ease) .2s both; }
  @keyframes shine { to { background-position: -250% 0; } }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); filter: blur(8px); } }
  .marquee { overflow: hidden; white-space: nowrap; border-block: 1px solid var(--line); padding: .5rem 0; color: var(--muted); font-size: .85rem; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee div { display: inline-block; animation: marquee 40s linear infinite; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  .lead { font-size: 1.05rem; }
  .num { font-family: var(--en); font-weight: 800; font-size: 2.2rem; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--accent); }
  .entries { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .entry { display: flex; flex-direction: column; gap: .25rem; text-decoration: none; color: inherit; }
  .entry { min-height: 10rem; justify-content: flex-end; }
  .entry strong { font-size: 1.3rem; color: var(--fg); transition: color .3s; }
  .entry:hover strong { color: var(--accent); }
</style>
