---
import Base from '../layouts/Base.astro';
import { getSongs, getPhases, getEvents, url, formatDate } from '../lib/data';
const songs = await getSongs();
const phases = await getPhases();
const events = await getEvents();
const songTitle = new Map(songs.map((s) => [s.id, s.data.title]));
---
<Base title="年表">
  <h1>年表</h1>
  <p class="muted">時期ごとの出来事と、その時期に出た曲です。出来事の下の番号は出典です。</p>
  {phases.map((p) => {
    const ev = events.filter((e) => e.data.phase === p.id);
    const ps = songs.filter((s) => s.data.phase === p.id);
    return (
      <section id={p.id}>
        <h2>{p.data.name}<span class="muted range">{formatDate(p.data.start)} 〜 {p.data.end ? formatDate(p.data.end) : '現在'}</span></h2>
        <p>{p.data.summary}</p>
        <p class="muted">出典: {p.data.sources.map((s, i) => <><a href={s.url} rel="noopener" target="_blank">{s.media}「{s.title}」</a>{i < p.data.sources.length - 1 && '、'}</>)}</p>
        <ol class="events">
          {ev.map((e) => (
            <li>
              <time>{formatDate(e.data.date)}</time>
              <div>
                <strong>{e.data.title}</strong>
                <p>{e.data.description}</p>
                {e.data.relatedSongs.length > 0 && (
                  <p class="songs">関連曲: {e.data.relatedSongs.map((id, i) => <><a href={url(`/songs/${id}/`)}>{songTitle.get(id)}</a>{i < e.data.relatedSongs.length - 1 && '、'}</>)}</p>
                )}
                <p class="src">{e.data.sources.map((s, i) => <a href={s.url} rel="noopener" target="_blank">[{i + 1}] {s.media}</a>)}</p>
              </div>
            </li>
          ))}
        </ol>
        {ps.length > 0 && (
          <details>
            <summary>この時期の曲（{ps.length}曲）</summary>
            <ul class="songlist">{ps.map((s) => <li><a href={url(`/songs/${s.id}/`)}>{s.data.title}</a></li>)}</ul>
          </details>
        )}
      </section>
    );
  })}
</Base>
<style>
  .range { font-size: .85rem; font-weight: normal; margin-left: .75rem; }
  .events { list-style: none; padding: 0; border-left: 3px solid var(--line); margin-left: .5rem; }
  .events li { display: grid; gap: .1rem; padding: .25rem 0 .75rem 1rem; position: relative; }
  .events { border-left-color: transparent; border-image: linear-gradient(var(--accent), var(--deep)) 1; }
  .events li::before { content: ''; position: absolute; left: -8px; top: .7rem; width: 13px; height: 13px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(226, 255, 145, .15), 0 0 16px var(--accent); animation: pulse 2.8s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 8px rgba(226, 255, 145, 0), 0 0 24px var(--accent); } }
  .events strong { font-size: 1.05rem; }
  .events time { font-family: var(--en); font-weight: 600; color: var(--accent); font-size: .85rem; }
  .events p { margin: .2rem 0; }
  .src { display: flex; gap: .5rem; flex-wrap: wrap; font-size: .8rem; }
  .songs { font-size: .9rem; }
  .songlist { columns: 2; }
  summary { cursor: pointer; color: var(--accent); }
</style>
