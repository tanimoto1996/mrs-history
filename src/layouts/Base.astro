---
import { url, buildDate, formatDate } from '../lib/data';
interface Props { title?: string }
const { title } = Astro.props;
const here = (path: string) => (Astro.url.pathname.startsWith(url(path)) ? 'page' : undefined);
const fullTitle = title ? `${title} | ミセスの歴史と曲の背景` : 'ミセスの歴史と曲の背景';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=Zen+Kaku+Gothic+New:wght@400;700;900&display=swap" />
  </head>
  <body>
    <div class="orbs" aria-hidden="true"><span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span></div>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="logo" href={url('/')}><span class="logo-en">Mrs. HISTORY</span><span class="logo-ja">ミセスの歴史と曲の背景</span></a>
      <nav aria-label="メイン">
        <a href={url('/timeline/')} aria-current={here('/timeline/')}>年表</a>
        <a href={url('/songs/')} aria-current={here('/songs/')}>曲</a>
        <a href={url('/works/')} aria-current={here('/works/')}>作品</a>
        <a href={url('/members/')} aria-current={here('/members/')}>メンバー</a>
        <a href={url('/about/')} aria-current={here('/about/')}>サイトについて</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>{formatDate(buildDate)}時点の情報です。非公式のファンサイトで、AIが出典をもとに作成しています（人による確認はしていません）。</p>
    </footer>
    <script>
      // スクロールで要素をふわっと出す。動きを減らす設定の人には何もしない
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('main > *, main section > *, .events li, .list li, .bg li, .sources li');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el, i) => {
          el.classList.add('reveal');
          (el as HTMLElement).style.setProperty('--d', `${Math.min(i % 8, 7) * 60}ms`);
          io.observe(el);
        });
      }
      const bar = document.querySelector<HTMLElement>('.progress')!;
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
        header.classList.toggle('scrolled', scrollY > 8);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
<style is:global>
  /* 公式サイト（mrsgreenapple.com）の配色: 深緑 #002928・ライム #E2FF91・クリーム #FAFFDF */
  :root {
    --fg: #FAFFDF; --muted: rgba(250, 255, 223, .62); --bg: #002928; --card: rgba(3, 61, 60, .55); --line: rgba(226, 255, 145, .16);
    --accent: #E2FF91; --accent2: #A7DA20; --deep: #005e3c;
    --official: #54ADFF; --interp: #ffa223; --secondary: #969696;
    --en: "Plus Jakarta Sans", sans-serif;
    --ease: cubic-bezier(.22, 1, .36, 1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: "Zen Kaku Gothic New", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif; color: var(--fg); background: var(--bg); line-height: 1.9; letter-spacing: .03em; overflow-x: hidden; }
  ::selection { background: var(--accent); color: var(--bg); }
  a { color: var(--accent); text-underline-offset: .2em; transition: color .3s, opacity .3s; }
  a:hover { color: #fff; }
  main { position: relative; max-width: 820px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.35; margin: 1.5rem 0 1rem; font-weight: 900; letter-spacing: .04em; }
  h2 { position: relative; font-size: 1.3rem; font-weight: 900; margin-top: 3rem; padding-bottom: .5rem; border-bottom: 1px solid var(--line); }
  h2::after { content: ''; position: absolute; left: 0; bottom: -1px; width: 3rem; height: 2px; background: var(--accent); }

  /* ぼかした光の玉がゆっくり漂う背景 */
  .orbs { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55; will-change: transform; }
  .o1 { width: 48vmax; height: 48vmax; background: #005e3c; top: -18vmax; left: -12vmax; animation: drift1 26s ease-in-out infinite alternate; }
  .o2 { width: 36vmax; height: 36vmax; background: #A7DA20; opacity: .22; bottom: -14vmax; right: -10vmax; animation: drift2 32s ease-in-out infinite alternate; }
  .o3 { width: 26vmax; height: 26vmax; background: #31C9BA; opacity: .2; top: 40%; left: 55%; animation: drift3 22s ease-in-out infinite alternate; }
  @keyframes drift1 { to { transform: translate(18vw, 22vh) scale(1.15); } }
  @keyframes drift2 { to { transform: translate(-22vw, -18vh) scale(.9); } }
  @keyframes drift3 { to { transform: translate(-30vw, 12vh) scale(1.3); } }

  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 20; background: linear-gradient(90deg, var(--accent2), var(--accent)); transform-origin: 0 50%; transform: scaleX(0); }

  .site-header { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; position: sticky; top: 0; z-index: 10; transition: background .4s, backdrop-filter .4s, padding .4s; }
  .site-header.scrolled { background: rgba(0, 41, 40, .72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); padding: .6rem 1.5rem; border-bottom: 1px solid var(--line); }
  .logo { display: flex; flex-direction: column; line-height: 1.2; color: var(--fg); text-decoration: none; }
  .logo-en { font-family: var(--en); font-weight: 800; font-size: 1.15rem; letter-spacing: .06em; color: var(--accent); }
  .logo-ja { font-size: .7rem; color: var(--muted); }
  nav { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; font-size: .9rem; }
  .site-header nav a { position: relative; color: var(--fg); text-decoration: none; font-weight: 700; }
  .site-header nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform .4s var(--ease); }
  .site-header nav a:hover, .site-header nav a[aria-current] { color: var(--accent); }
  .site-header nav a[aria-current]::after { transform: scaleX(1); }
  .site-header nav a:hover::after { transform: scaleX(1); transform-origin: left; }

  .site-footer { max-width: 820px; margin: 0 auto; padding: 1.5rem 1.25rem 2.5rem; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--line); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 1.25rem; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  a.card { transition: transform .5s var(--ease), border-color .4s, box-shadow .5s; }
  a.card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 16px 40px -16px rgba(226, 255, 145, .35); }
  .muted { color: var(--muted); font-size: .9rem; }
  .tag { display: inline-block; font-size: .72rem; padding: 0 .6rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  input, select { font: inherit; color: var(--fg); background: rgba(0, 41, 40, .6); border: 1px solid var(--line) !important; transition: border-color .3s, box-shadow .3s; }
  input:focus, select:focus { outline: none; border-color: var(--accent) !important; box-shadow: 0 0 0 3px rgba(226, 255, 145, .18); }
  select option { background: #002928; }
  input[type=checkbox] { accent-color: var(--accent); }
  details summary { cursor: pointer; }

  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .9s var(--ease) var(--d, 0ms), transform .9s var(--ease) var(--d, 0ms); }
  .reveal.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    html { scroll-behavior: auto; }
  }
</style>
