---
import { url, buildDate, formatDate } from '../lib/data';
interface Props { title?: string }
const { title } = Astro.props;
const fullTitle = title ? `${title} | ミセスの歴史と曲の背景` : 'ミセスの歴史と曲の背景';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={url('/')}>ミセスの歴史と曲の背景</a>
      <nav>
        <a href={url('/timeline/')}>年表</a>
        <a href={url('/songs/')}>曲</a>
        <a href={url('/about/')}>このサイトについて</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>{formatDate(buildDate)}時点の情報です。非公式のファンサイトで、AIが出典をもとに作成しています（人による確認はしていません）。</p>
    </footer>
  </body>
</html>
<style is:global>
  :root { --fg: #1f2a24; --muted: #5b6b62; --bg: #fbfcf8; --card: #fff; --line: #e2e8df; --accent: #2f8f5b; --official: #1f6fb2; --interp: #b0651c; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif; color: var(--fg); background: var(--bg); line-height: 1.8; }
  a { color: var(--accent); }
  main { max-width: 760px; margin: 0 auto; padding: 1rem 1rem 3rem; }
  h1 { font-size: 1.6rem; line-height: 1.4; margin: 1rem 0; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 2px solid var(--line); padding-bottom: .25rem; }
  .site-header { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; padding: .75rem 1rem; border-bottom: 1px solid var(--line); background: var(--card); position: sticky; top: 0; z-index: 10; }
  .logo { font-weight: 700; color: var(--fg); text-decoration: none; }
  nav { display: flex; gap: 1rem; font-size: .95rem; }
  nav a { text-decoration: none; }
  .site-footer { max-width: 760px; margin: 0 auto; padding: 1rem; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--line); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 1rem; }
  .muted { color: var(--muted); font-size: .9rem; }
  .tag { display: inline-block; font-size: .75rem; padding: 0 .5rem; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
</style>
